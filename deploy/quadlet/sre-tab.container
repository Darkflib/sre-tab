[Unit]
Description=Developer News Dashboard application
After=network-online.target
Wants=network-online.target
# The ordering that acceptance criterion 6 rests on: PostgreSQL accepting
# connections, then migrations applied, then the app serves traffic. Requires=
# means a failure in either propagates here instead of leaving the app up
# against a schema it does not match.
Requires=sre-tab-db.service sre-tab-migrate.service
After=sre-tab-db.service sre-tab-migrate.service

[Container]
ContainerName=sre-tab-app
Image=ghcr.io/darkflib/sre-tab:sha-fbf0f0ad2aa48e1254902ffb897d85657ab81908@sha256:4a4ccc313bec5277d3a7485bd1bb627aba1e7bf18253e2b340f134ef00a205e5
# Pinned by tag and digest, like every other image in this deployment. The
# tag says which commit this is; the digest is the part podman enforces, and
# it is the reason `latest` is gone: with `:latest` and Pull=newer, a restart
# silently adopted whatever CI last pushed to main, so the running version
# was decided by whoever merged most recently rather than by anyone
# deploying. Upgrading is now a commit.
#
# Change it with deploy/scripts/promote.sh, which resolves a published build
# to its digest, refuses to write one that cosign cannot verify as ours, and
# moves all three application units together. See deploy/README.md.
#
# Pull=missing rather than newer: a digest names immutable content, so a copy
# already in the local store is by definition the right one, and a restart
# after a reboot does not need the registry to be reachable. `newer` against
# a digest is a network round trip that can only ever confirm what is
# already true.
#
# Measured on Debian 13 / podman 5.4.2, cold boot with this pin in place: no
# registry traffic from any unit, and the start ordering unchanged —
# PostgreSQL accepting connections at T+3.3s, systemd calling the unit
# started at T+13.5s (the Notify=healthy gate on pg_isready), migrations
# T+13.5s to T+21.4s, this unit started T+56s. The gap is the property; the
# pin does not narrow it.
Pull=missing
Network=sre-tab.network

# Non-secret configuration, installed from deploy/app.env.example and edited
# in place by the operator.
EnvironmentFile=/etc/sre-tab/app.env

# Everything genuinely secret arrives as a podman secret, never inline in this
# file and never on a command line. DATABASE_URL is a secret in its own right
# because it carries the database password in the URL.
Secret=sre-tab-database-url,type=env,target=DATABASE_URL
Secret=sre-tab-github-client-secret,type=env,target=GITHUB_CLIENT_SECRET
Secret=sre-tab-session-secret,type=env,target=SESSION_SECRET

# No PublishPort: the app is reachable only from sre-tab.network, and only
# sre-tab-web (Caddy) is on the far side of a published port.

ReadOnly=true
Tmpfs=/tmp:rw,nosuid,nodev,size=64M
# NoNewPrivileges is deliberately NOT set here, for the same reason as
# sre-tab-db.container — read the long note there first, because this looks
# like a gratuitous relaxation and is not.
#
# Under no_new_privs, podman's AppArmor profile denies this container's
# processes the right to deliver signals, including to themselves. uvicorn
# ends a graceful shutdown by re-raising the signal it caught
# (signal.raise_signal, uvicorn/server.py:340) so its exit status reports death
# by SIGTERM; that raise comes back EPERM, the PermissionError propagates, and
# uvicorn exits 1. Every clean `systemctl stop` then lands in
# `systemctl --failed`, which deploy/README.md names as *the* place real
# failures surface — so the one signal worth keeping is buried in false ones.
#
# Measured on the host, stopping this image five ways:
#
#   uvicorn as PID 1, NNP on         973ms   exit 1   PermissionError
#   uvicorn as PID 1, NNP off        973ms   exit 0   clean
#   Init=true (catatonit), NNP on   30409ms  exit 137 SIGTERM denied, SIGKILLed
#   Init=true (catatonit), NNP off    631ms  exit 143 clean
#   tini in the image, NNP on         392ms  exit 1   "error forwarding signal"
#
# So an init process is not the fix: it needs the same signal delivery, and
# under NNP podman's own catatonit turns every stop into a 30-second hang
# ending in SIGKILL — strictly worse than the bug. SuccessExitStatus=1 is not
# the fix either; it would silence a genuine exit-1 alongside this one.
#
# What is lost by dropping the flag is covered instead: the image strips every
# setuid and setgid bit at build time (see Containerfile), which removes the
# escalation NoNewPrivileges existed to neuter rather than merely disarming it
# at runtime. DropCapability=all, User=, and the read-only rootfs are untouched.
DropCapability=all
User=10001
Group=10001

# No HealthCmd= here on purpose. The image carries its own HEALTHCHECK
# against /api/v1/healthz (see Containerfile) and podman honours it, so there
# is exactly one definition to keep correct — and no shell quoting to get
# wrong in a unit file that cannot be tested on a developer's macOS host.
#
# The dependency is real, though: Notify=healthy below waits for that
# healthcheck, so an image built in OCI format (which drops HEALTHCHECK)
# would make this unit hang until TimeoutStartSec. CI asserts the healthcheck
# survives `podman build --format docker` for exactly this reason.
Notify=healthy

LogDriver=journald
PidsLimit=256

[Service]
Restart=always
RestartSec=5s
MemoryMax=768M
TimeoutStartSec=5m
# uvicorn is PID 1, handles SIGTERM directly, and drains — so this is a drain
# window rather than a countdown to SIGKILL. Measured at under a second.
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
