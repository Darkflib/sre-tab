[Unit]
Description=Back up the Developer News Dashboard database
Requires=sre-tab-db.service
After=sre-tab-db.service

[Container]
ContainerName=sre-tab-backup
# The same pinned server image, so pg_dump's version always matches the
# server it is dumping. A newer client can read an older server, but the
# reverse silently fails on a major upgrade — pinning both to one line
# removes the question.
Image=docker.io/library/postgres:18-trixie@sha256:4ef4dbc939d61acea57712655ddb4b4ab27419c913f94cca0cd57cb3ea3c2280
Pull=missing
Network=sre-tab.network

Volume=/srv/sre-tab/backups:/backups:rw
Volume=/etc/sre-tab/backup.sh:/usr/local/bin/sre-tab-backup:ro
Exec=/usr/local/bin/sre-tab-backup

Environment=PGHOST=sre-tab-db
# sretab_readonly, not the superuser. pg_dump needs SELECT and nothing else,
# and this unit runs unattended every night against a database whose entire
# contents it is authorised to read — which is precisely the credential worth
# keeping incapable of writing anything.
#
# SELECT on sequences as well as on tables is not optional here, and it is
# the non-obvious half: a custom-format dump emits a setval() per sequence so
# that a restore's next INSERT does not collide with the rows it just loaded,
# and reading a sequence's current value needs SELECT on the sequence itself.
# A role granted table-SELECT alone makes pg_dump fail outright rather than
# produce a subtly wrong dump — checked, and the reason deploy/roles.sql
# grants both.
Environment=PGUSER=sretab_readonly
Environment=PGDATABASE=sretab
Environment=BACKUP_DIR=/backups
Environment=BACKUP_KEEP_DAYS=14
# PGPASSWORD from a podman secret rather than the environment file: the
# backup job is the one place outside the database container that needs the
# password, and it should not be readable in /etc.
#
# sre-tab-readonly-password holds a bare password rather than a URL, because
# that is the shape libpq's PGPASSWORD wants and the shape
# create-roles.sh mints for this role. sre-tab-postgres-password is left in
# place and unread by this unit — the database container still consumes it as
# POSTGRES_PASSWORD, and it is half of the rollback path.
Secret=sre-tab-readonly-password,type=env,target=PGPASSWORD

ReadOnly=true
Tmpfs=/tmp:rw,nosuid,nodev,size=64M
NoNewPrivileges=true
DropCapability=all
# uid 999 is `postgres` in this image. pg_dump needs no privilege beyond
# writing to /backups, which install.sh creates owned by 999:999.
User=999
Group=999
LogDriver=none
PidsLimit=64

[Service]
Type=oneshot
MemoryMax=512M
# A dump of a v1-sized database is seconds; the hour is headroom for a host
# under load rather than an expectation.
TimeoutStartSec=1h
