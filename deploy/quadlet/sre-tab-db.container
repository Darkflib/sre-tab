[Unit]
Description=Developer News Dashboard PostgreSQL
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=sre-tab-db
Image=docker.io/library/postgres:18-trixie@sha256:06cad38a5d9f5d24b4d83d86def30795d5e4b757fedbf5281172b576dedcd941
# Version-pinned, so a restart must not depend on Docker Hub being
# reachable. Upgrades happen by changing the pin, deliberately, with the
# major-version note in deploy/README.md read first.
Pull=missing
Network=sre-tab.network
# postgres:18 moved PGDATA to /var/lib/postgresql/18/docker and declares the
# volume one level up at /var/lib/postgresql. Mounting the parent is
# therefore correct here and would have been wrong on postgres:17 — check
# this line before any major-version bump.
Volume=sre-tab-db.volume:/var/lib/postgresql:rw

# No PublishPort. The database is reachable only from sre-tab.network; there
# is no path to it from the host or the outside world.

Environment=POSTGRES_USER=sretab
Environment=POSTGRES_DB=sretab
Environment=POSTGRES_INITDB_ARGS=--data-checksums
# Podman secret, created by deploy/scripts/create-secrets.sh. The password
# never appears in this file, in `podman inspect`, or in the journal.
Secret=sre-tab-postgres-password,type=env,target=POSTGRES_PASSWORD

ReadOnly=true
# The only writable paths postgres needs outside its data volume: the unix
# socket directory and scratch space.
Tmpfs=/tmp:rw,nosuid,nodev,mode=1777
Tmpfs=/run:rw,nosuid,nodev
Tmpfs=/var/run/postgresql:rw,nosuid,nodev,mode=0755
# NoNewPrivileges is deliberately NOT set here, and this is the only unit in
# the stack without it. Do not "restore the hardening" — it costs five minutes
# of boot hang on every start, not just the first.
#
# Under no_new_privs this image never finishes starting, because AppArmor then
# refuses the profile transition crun performs on exec. Some of the container's
# processes end up confined by `containers-default-<ver>` and some by the
# `containers-default-<ver>//&crun` sub-profile, and cross-profile signals are
# denied between them. The kernel says so plainly:
#
#   apparmor="DENIED" operation="signal" profile="containers-default-0.62.2"
#     comm="postgres" requested_mask="send" signal=usr1
#     peer="containers-default-0.62.2//&crun"
#
# Signals are how both halves of this image's start-up talk, so both halves
# hang, in different ways:
#
#   * as root (this configuration): PID 1 sticks at `gosu postgres
#     /usr/local/bin/docker-entrypoint.sh postgres` at ~99.7% CPU, the Go
#     runtime (gosu 1.19, go1.24.6) live-locking in an unbounded sched_yield()
#     loop while its signal proxying is denied (signal=int in the log above);
#   * with User=999:999, which skips the root branch and gosu entirely: initdb
#     completes, but the postmaster cannot SIGUSR1 its own backends, so the
#     entrypoint's `psql` sits against a backend parked in `authentication`
#     and "PostgreSQL init process complete" never arrives.
#
# Measured on Debian 13 / podman 5.4.2 / crun 1.21 / kernel 6.12, on a fresh
# volume and an existing one. A flag matrix isolated no_new_privs as the only
# variable that matters: every combination with it wedged — as root, as
# User=999:999, with and without DropCapability, with and without the
# read-only rootfs and the tmpfs layout — and every combination without it
# reached "init process complete" in 3s. `--security-opt apparmor=unconfined`
# also fixes it, which is what identifies the mechanism, and is a worse trade:
# it would give up all of podman's confinement to regain a flag whose whole
# purpose is blocking a setuid escalation this container performs on purpose.
#
# Every other unit here keeps NoNewPrivileges=true. They are single-process
# and never signal across that boundary, so none of them trips it.
DropCapability=all
# The official entrypoint starts as root to create and chown PGDATA, then
# drops to uid 999 with gosu for the server itself. These five are what that
# sequence needs and nothing more; the postmaster runs unprivileged.
# No User= here: see the no_new_privs note above — it was tried, and it trades
# one hang for another rather than buying the hardening back.
AddCapability=CHOWN DAC_OVERRIDE FOWNER SETGID SETUID

# Readiness, not liveness: pg_isready answers only once the postmaster is
# accepting connections. Paired with Notify=healthy below, this is what makes
# "the app starts after the database is genuinely up" true rather than hoped
# for — systemd holds sre-tab-migrate.service until this passes.
HealthCmd=pg_isready --quiet --username=sretab --dbname=sretab
HealthInterval=10s
HealthTimeout=5s
HealthRetries=12
HealthStartPeriod=10s
# Requires podman 5.0 or newer. Without it the unit reports "started" the
# moment the container process exists, and migrations race initdb.
Notify=healthy

# Long-running, so `podman logs sre-tab-db` is worth having — the same
# reasoning as orbit-data-web.container.
LogDriver=journald
PidsLimit=256

[Service]
Restart=always
RestartSec=5s
MemoryMax=1G
# Generous: a first start runs initdb on an empty volume.
TimeoutStartSec=5m
# The image sets STOPSIGNAL SIGINT, which is postgres' fast shutdown. Podman
# honours it, so this is a real drain window and not a wait for SIGKILL.
TimeoutStopSec=1m

[Install]
WantedBy=multi-user.target
