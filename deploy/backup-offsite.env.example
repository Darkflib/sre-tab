# Off-host backup configuration for the Developer News Dashboard.
#
# Copy to /etc/sre-tab/backup-offsite.env and edit. THE FILE'S EXISTENCE IS
# THE SWITCH: sre-tab-backup-offsite.service carries
# ConditionPathExists= on it, so a host without it never runs the copy, and a
# host with it must have at least one target or the unit fails loudly.
#
#     sudo install -m 0600 -o root -g root \
#         /etc/sre-tab/backup-offsite.env.example \
#         /etc/sre-tab/backup-offsite.env
#     sudo "$EDITOR" /etc/sre-tab/backup-offsite.env
#     sudo systemctl start sre-tab-backup-offsite.service
#
# 0600 root:root and no looser. systemd reads it as root before dropping to
# the sre-tab-offsite user, so the service does not need to read it and
# neither does anyone else; the S3 secret below is in here. deploy/install.sh
# warns if it finds this file group- or world-readable.

# ---------------------------------------------------------------------------
# Targets
# ---------------------------------------------------------------------------
#
# A space-separated list of URLs. The scheme picks the transport, so there is
# no separate mode setting that could disagree with the address. Configure one
# or both; a copy in each place is exactly what this is for.
#
#   ssh://user@host[:port]/far/end/directory
#   s3://bucket/prefix
#
# The directory in an ssh target is checked against the receiving script's own
# configuration and refused if it disagrees -- it is an assertion, not an
# instruction. Multiple targets of the same scheme share one set of
# credentials below.

BACKUP_OFFSITE_TARGETS=""
#BACKUP_OFFSITE_TARGETS="ssh://sre-tab-offsite@backup.example.net/home/sre-tab-offsite/sre-tab-offsite s3://my-bucket/sre-tab"

# ---------------------------------------------------------------------------
# What is copied
# ---------------------------------------------------------------------------

# Must match BACKUP_DIR and PGDATABASE in deploy/quadlet/sre-tab-backup.container.
BACKUP_DIR=/srv/sre-tab/backups
BACKUP_DATABASE=sretab

# The retention window at the far end, matching BACKUP_KEEP_DAYS in the backup
# unit. For S3 it is the window this script would use if asked to prune; for
# ssh it is set on the receiving host instead, because the sending host is not
# given a way to delete anything (see deploy/scripts/backup-offsite-receive.sh).
BACKUP_KEEP_DAYS=14

# Refuse to copy a dump older than this, in hours. A stale dump means the
# backup pipeline has stopped somewhere this script cannot see, and copying it
# while exiting zero would report a healthy pipeline. 0 disables the check,
# which is worth doing only to re-send an old dump by hand.
OFFSITE_MAX_DUMP_AGE_HOURS=48

# ---------------------------------------------------------------------------
# ssh transport
# ---------------------------------------------------------------------------

# A key used for nothing else, 0400 and owned by sre-tab-offsite, with a
# restricted authorised-keys entry at the far end. deploy/README.md has the
# exact line to paste.
OFFSITE_SSH_KEY=/etc/sre-tab/backup-offsite.key

# Host keys are pinned, not learned. Trust-on-first-use would hand the dumps
# to whoever answered on the night this file was empty:
#
#     ssh-keyscan -p 22 backup.example.net | sudo tee /etc/sre-tab/backup-offsite.known_hosts
#
# then compare the fingerprint against the far host itself before relying on it.
OFFSITE_SSH_KNOWN_HOSTS=/etc/sre-tab/backup-offsite.known_hosts

OFFSITE_SSH_CONNECT_TIMEOUT=30

# ---------------------------------------------------------------------------
# S3 transport
# ---------------------------------------------------------------------------

# Leave empty for AWS proper. Set it for anything else -- MinIO, Garage,
# Backblaze B2, Wasabi, Hetzner -- which is the common case for a self-hosted
# deployment and is a supported configuration rather than an escape hatch.
OFFSITE_S3_ENDPOINT=
#OFFSITE_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com

# Required by the signature even where the provider ignores it. Providers that
# do not have regions generally accept us-east-1.
OFFSITE_S3_REGION=us-east-1

# auto: path-style when OFFSITE_S3_ENDPOINT is set, virtual-hosted otherwise.
# Self-hosted implementations need a wildcard DNS record and a matching
# certificate before they will answer to bucket.host, so path-style is the
# right default for them; AWS prefers virtual-hosted.
OFFSITE_S3_ADDRESSING=auto

# Scoped to PutObject and GetObject on this one prefix -- deploy/README.md has
# the policy JSON, and it is load-bearing rather than tidy-minded.
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=

# Off by default, and the default is the recommendation. Expiring old objects
# with a bucket lifecycle rule needs no delete permission on the host holding
# the database, which is the whole point of Object Lock in compliance mode:
# a compromised host cannot destroy what it has already sent. Turn this on
# only for a store with neither lifecycle rules nor Object Lock.
OFFSITE_S3_PRUNE=false

# Ceiling for a single request, in seconds.
OFFSITE_TIMEOUT_SECONDS=3600
