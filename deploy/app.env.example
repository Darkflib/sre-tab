# Non-secret runtime configuration for the deployed application.
#
# Install to /etc/sre-tab/app.env (deploy/install.sh does this, without
# overwriting an existing file) and edit in place. It is read by
# sre-tab.container and sre-tab-migrate.container via EnvironmentFile=.
#
# Anything genuinely secret is deliberately ABSENT from this file and arrives
# as a podman secret instead — DATABASE_URL (it carries the database
# password), GITHUB_CLIENT_SECRET, and SESSION_SECRET. Create them with
# deploy/scripts/create-secrets.sh.
#
# The full catalogue of settings, with defaults and explanations, is
# .env.example in the repository root; every name there maps to a field in
# app/settings.py. Only the ones a deployment actually has to change are
# repeated here.

# --- Core ----------------------------------------------------------------

# The public origin, as users reach it through the TLS-terminating proxy.
# The application builds absolute URLs from this rather than from forwarded
# headers, so it must be the external https:// origin and not the internal
# loopback address.
APP_BASE_URL=https://news.example.com

# Interactive API docs. Off unless the operator wants the Swagger UI exposed;
# /api/v1/openapi.json is served either way. This line now restates the
# application default rather than correcting it — a deployment that never got
# this file is closed too.
DOCS_ENABLED=false

# --- GitHub OAuth --------------------------------------------------------

# Not a secret: the client ID is public by design. The matching client secret
# is the sre-tab-github-client-secret podman secret.
GITHUB_CLIENT_ID=

# Must match the OAuth app registration character for character, and must be
# APP_BASE_URL + /api/v1/auth/github/callback.
GITHUB_REDIRECT_URI=https://news.example.com/api/v1/auth/github/callback

# Comma-separated numeric GitHub user IDs allowed to sign in.
#
# ============================================================================
# AN EMPTY VALUE DENIES EVERYONE. That is correct fail-closed behaviour and it
# is also the single most likely thing to look like a broken deployment on
# first start: OAuth completes at GitHub, the callback returns 403, and
# nothing about the page says "you are not on the list". If sign-in is
# refused, check this first, and check the journal for
# `oauth_denied_not_allow_listed` — it logs the numeric ID that was refused,
# which is the value to add here.
# ============================================================================
#
# Left empty on purpose, and it is the one value in this file that must be
# filled in before the stack is any use. install.sh copies this template to
# /etc/sre-tab/app.env verbatim, so anything named here is authorised on a
# fresh deployment — and GitHub user IDs are global, not scoped to an OAuth
# app, so a self-hoster who registers their own OAuth application and edits
# every credential in this file would still be granting access to whoever was
# listed here. Shipping a populated default made that a thing an operator had
# to notice rather than a thing they had to do.
#
# IDs are public identifiers, not secrets: anyone can read one from
# https://api.github.com/users/<login>, or from the
# `oauth_denied_not_allow_listed` journal line after a refused sign-in. Add or
# remove entries as people join and leave; a removed ID cannot sign in again,
# though an existing session survives until it expires or is revoked.
#
# The upstream project's own operators, for reference — copy these only if you
# actually intend to grant them access to your instance:
#
#   101405    darkflib      Mike Preston
#   31023     wsuff         William Suffill
#   14904229  ricardobalk   Ricardo Balk
ALLOWED_GITHUB_IDS=

# --- Logging -------------------------------------------------------------

LOG_LEVEL=INFO
LOG_JSON=true

# --- Proxy -----------------------------------------------------------------

# Read by uvicorn, not by app/settings.py, and it does two different jobs at
# once — which is why it names two addresses and not one.
#
#   10.89.61.20  Caddy's fixed address on sre-tab.network. uvicorn only reads
#                X-Forwarded-For at all when the *peer* is on this list.
#   10.89.61.1   The gateway on that network: the source address a connection
#                to the published 127.0.0.1:8080 port arrives from after
#                Podman has DNATed it, and therefore the hop Caddy appends to
#                X-Forwarded-For.
#
# uvicorn walks the chain from the right and takes the first address it does
# NOT trust. Drop 10.89.61.1 and it stops there, so every request buckets
# under one address and per-IP rate limiting silently becomes global.
#
# Three hops, not two: if the host's TLS proxy is itself behind a CDN or load
# balancer, add that hop's address here as well, or uvicorn will stop at it
# for the same reason.
#
# Never `*`. That branch tells uvicorn to take the leftmost value, which is
# whatever the client wrote — a caller could then choose its own rate-limit
# bucket.
#
# This works only in concert with `trusted_proxies` in deploy/Caddyfile:
# without that, Caddy discards the TLS proxy's X-Forwarded-For rather than
# appending to it, and the real client address never leaves the front door.
# Change one and check the other.
FORWARDED_ALLOW_IPS=10.89.61.20,10.89.61.1

# --- Feed refresh --------------------------------------------------------

# Defaults from .env.example apply to everything not set here. Uncomment to
# override.
# FEED_RETENTION_DAYS=90
# SOURCE_REFRESH_ENABLED=true
# SOURCE_DEFAULT_REFRESH_MINUTES=30
