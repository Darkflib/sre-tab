# Developer News Dashboard — environment configuration.
# Copy to .env for local development; every variable maps to a field in
# app/settings.py. Values shown are the defaults unless marked required.

# --- Core ----------------------------------------------------------------

# SQLAlchemy database URL. SQLite for dev, PostgreSQL in production,
# e.g. postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./dev.db

# Public origin the app is served from; used to build absolute URLs.
APP_BASE_URL=http://localhost:8000

# Serve interactive API docs at /docs. Disable in production if the
# operator wants the schema private (openapi.json remains served).
DOCS_ENABLED=true

# --- GitHub OAuth (required in production) -------------------------------

# OAuth app credentials from https://github.com/settings/developers.
# The client secret must only ever live here — never in the database.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Exact allow-listed callback URL; must match the OAuth app registration
# character for character.
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback

# Comma-separated numeric GitHub user IDs permitted to sign in
# (e.g. 583231,1024025). An EMPTY list denies everyone — sign-in is
# allow-list only in v1. Find an ID at https://api.github.com/users/<login>
ALLOWED_GITHUB_IDS=

# --- Sessions and CSRF ---------------------------------------------------

# Secret for CSRF token signing and other HMAC use. REQUIRED in
# production: without it a random per-process value is used and every
# restart invalidates outstanding CSRF tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Days a session stays valid after issue.
SESSION_TTL_DAYS=14

# Cookie and header names; change only if a proxy requires it.
SESSION_COOKIE_NAME=session
CSRF_COOKIE_NAME=csrftoken
CSRF_HEADER_NAME=X-CSRF-Token

# `Secure` on the session, CSRF, and OAuth-state cookies. Leave it true
# everywhere real: false hands the session cookie to anyone on the path.
#
# The one case it exists for is development against a host that is not
# localhost, over plain http — browsers exempt localhost from the Secure
# rule, so ordinary local work needs nothing here, but a browser pointed at
# http://dev-box.lan silently drops every cookie and sign-in looks broken
# rather than misconfigured.
COOKIE_SECURE=true

# --- Feed retention and source refresh -----------------------------------

# Days to retain fetched feed items before the scheduled prune removes them.
FEED_RETENTION_DAYS=90

# Master switch for the in-process refresh scheduler.
SOURCE_REFRESH_ENABLED=true

# Refresh interval used when a source row does not set its own.
SOURCE_DEFAULT_REFRESH_MINUTES=30

# Per-fetch HTTP timeout in seconds.
SOURCE_FETCH_TIMEOUT_SECONDS=10

# Maximum response size in bytes accepted from a feed (default 5 MiB).
SOURCE_FETCH_MAX_BYTES=5242880

# Maximum redirect hops followed per fetch; every hop is re-checked
# against the SSRF guard.
SOURCE_FETCH_MAX_REDIRECTS=3

# User-Agent presented to feed servers.
SOURCE_FETCH_USER_AGENT=DevNewsDashboard/0.1 (self-hosted feed aggregator)

# --- Logging -------------------------------------------------------------

# Python log level: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# JSON log lines (true, production) or human-readable console (false, dev).
LOG_JSON=true
